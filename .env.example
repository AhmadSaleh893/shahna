# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# MongoDB connection string (local server or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name (optional, defaults to shahna)
MONGODB_DB=shahna

# Admin panel login at /admin
ADMIN_PASSWORD=change-me
# Random string of 32+ characters used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# WhatsApp number that receives orders, international format, digits only (e.g. 970599123456)
WHATSAPP_NUMBER=

# Currency used for prices (ISO 4217 code, e.g. USD, ILS, EUR)
NEXT_PUBLIC_CURRENCY=USD
